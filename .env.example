# Copy to .env and fill in. Never commit .env.
# Make a random secret with:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me-db-password
SECRET_KEY=change-me-to-64-random-hex-characters-from-openssl-rand-hex-32
ADMIN_PASSWORD=change-me-admin-password

# Starting password for the student accounts (they can change it later).
STUDENT_DEFAULT_PASSWORD=elements

# Student accounts created on first start: username:Display Name, comma-separated.
SEED_STUDENTS=soysauce:Soy Sauce,ketchupking:Ketchup King

# Port on your Mac that phones and tablets connect to.
WEB_PORT=8080
